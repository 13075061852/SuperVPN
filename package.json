{
  "name": "supervpn",
  "version": "0.6.1",
  "private": true,
  "description": "A quiet, rule-based Windows proxy client powered by sing-box",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "SuperVPN",
  "repository": {
    "type": "git",
    "url": "https://github.com/13075061852/SuperVPN.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "core:download": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-core.ps1",
    "icons:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-icons.ps1",
    "installer:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer-assets.ps1",
    "dist": "npm run build && npm run installer:assets && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "flag-icons": "^7.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "app.supervpn.desktop",
    "productName": "SuperVPN",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "desktop/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/core",
        "to": "core",
        "filter": [
          "sing-box.exe",
          "LICENSE*",
          "version.txt"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "13075061852",
        "repo": "SuperVPN",
        "releaseType": "release"
      }
    ],
    "artifactName": "SuperVPN-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "electron/app.ico",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "installerIcon": "electron/app.ico",
      "uninstallerIcon": "electron/app.ico",
      "installerHeader": "resources/installer/header.bmp",
      "installerSidebar": "resources/installer/sidebar.bmp",
      "uninstallerSidebar": "resources/installer/sidebar.bmp",
      "include": "resources/installer/installer.nsh"
    }
  }
}
